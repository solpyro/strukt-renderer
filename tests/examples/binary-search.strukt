title: Binary Search

# Returns the index of target in a sorted array, or -1 if not found

set low to 0
set high to length of array - 1
set result to -1

while low <= high:
    set mid to floor((low + high) / 2)
    if array[mid] == target:
        set result to mid
        break
    else if array[mid] < target:
        set low to mid + 1
    else:
        set high to mid - 1

return result
