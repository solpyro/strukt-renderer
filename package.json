{
  "name": "strukt-renderer",
  "version": "0.1.0",
  "description": "Parse Strukt pseudocode and render Nassi-Shneiderman diagrams as SVG",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rimraf dist"
  },
  "keywords": [
    "nassi-shneiderman",
    "structogram",
    "nsd",
    "strukt",
    "pseudocode",
    "svg",
    "diagram"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.0.1",
    "rimraf": "^6.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
